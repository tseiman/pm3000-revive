{
  "openapi": "3.1.0",
  "info": {
    "title": "PM3000 Modern Web UI REST API",
    "version": "1.0.0-stage3",
    "description": "Strict Stage 3 contract. Read-only inventory/status remain fixed-template operations; bearer-token administration is added with closed admin-only routes. Outlet actions remain shape-validated and are never dispatched."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "x-request-policy": {
    "unknownPaths": "reject",
    "unknownMethods": "reject",
    "unknownFields": "reject",
    "duplicateJsonNames": "reject",
    "contentEncoding": "reject",
    "backendXmlMaxBytes": 1048576,
    "backendXmlMaxDepth": 32
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Return process liveness without contacting the backend",
        "security": [],
        "x-handler": "local-liveness-only",
        "responses": {
          "200": {
            "description": "The REST process can parse and answer requests.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string",
                  "const": "nosniff"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/outlets": {
      "get": {
        "operationId": "listOutlets",
        "summary": "List the current outlet inventory and normalized status",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-backend-template": "action=get;path=units.topology;projection=outlet-list",
        "responses": {
          "200": {
            "$ref": "#/components/responses/OutletCollection"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "502": {
            "$ref": "#/components/responses/BackendProtocolError"
          },
          "503": {
            "$ref": "#/components/responses/BackendUnavailable"
          }
        },
        "x-required-scope": "read",
        "x-outlet-allowlist-behavior": "filter-collection"
      }
    },
    "/api/v1/outlets/{outletId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/OutletId"
        }
      ],
      "get": {
        "operationId": "getOutlet",
        "summary": "Return one outlet from a fresh inventory read",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-backend-template": "action=get;path=units.topology;projection=outlet-detail",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Outlet"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "502": {
            "$ref": "#/components/responses/BackendProtocolError"
          },
          "503": {
            "$ref": "#/components/responses/BackendUnavailable"
          }
        },
        "x-required-scope": "read",
        "x-outlet-allowlist-behavior": "require-membership"
      }
    },
    "/api/v1/outlets/{outletId}/actions": {
      "parameters": [
        {
          "$ref": "#/components/parameters/OutletId"
        }
      ],
      "post": {
        "operationId": "requestOutletAction",
        "summary": "Validate the reserved individual-outlet action shape without dispatching it",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-stage2-behavior": "reject-without-backend-request",
        "x-max-body-bytes": 1024,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OutletActionRequest"
              }
            }
          }
        },
        "responses": {
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/InventoryStale"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "503": {
            "description": "Stage 2 never dispatches an outlet action.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "action_disabled",
                  "message": "Outlet actions are disabled."
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/ContentTypeOptionsNoSniff"
              }
            }
          }
        },
        "x-required-scope": "control",
        "x-outlet-allowlist-behavior": "require-membership"
      }
    },
    "/api/v1/tokens": {
      "get": {
        "operationId": "listTokens",
        "summary": "List non-secret token metadata",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scope": "admin",
        "x-stage3-behavior": "token-store-only-no-backend-request",
        "responses": {
          "200": {
            "$ref": "#/components/responses/TokenCollection"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/TokenStoreUnavailable"
          }
        }
      },
      "post": {
        "operationId": "createToken",
        "summary": "Create a bearer token",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scope": "admin",
        "x-stage3-behavior": "token-store-only-no-backend-request",
        "x-max-body-bytes": 2048,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/TokenCreated"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "409": {
            "$ref": "#/components/responses/TokenLimitReached"
          },
          "503": {
            "$ref": "#/components/responses/TokenStoreUnavailable"
          }
        }
      }
    },
    "/api/v1/tokens/{tokenId}/disable": {
      "parameters": [
        {
          "name": "tokenId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/TokenRecordId"
          },
          "description": "Opaque token record identifier; never bearer-token plaintext."
        }
      ],
      "post": {
        "operationId": "disableToken",
        "summary": "Disable a token",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scope": "admin",
        "x-stage3-behavior": "token-store-only-no-backend-request",
        "responses": {
          "204": {
            "description": "Token disabled.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/ContentTypeOptionsNoSniff"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/LastAdministrator"
          },
          "503": {
            "$ref": "#/components/responses/TokenStoreUnavailable"
          }
        }
      }
    },
    "/api/v1/tokens/{tokenId}/enable": {
      "parameters": [
        {
          "name": "tokenId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/TokenRecordId"
          },
          "description": "Opaque token record identifier; never bearer-token plaintext."
        }
      ],
      "post": {
        "operationId": "enableToken",
        "summary": "Enable a token",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scope": "admin",
        "x-stage3-behavior": "token-store-only-no-backend-request",
        "responses": {
          "204": {
            "description": "Token enabled.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/ContentTypeOptionsNoSniff"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/LastAdministrator"
          },
          "503": {
            "$ref": "#/components/responses/TokenStoreUnavailable"
          }
        }
      }
    },
    "/api/v1/tokens/{tokenId}": {
      "parameters": [
        {
          "name": "tokenId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/TokenRecordId"
          },
          "description": "Opaque token record identifier; never bearer-token plaintext."
        }
      ],
      "delete": {
        "operationId": "revokeToken",
        "summary": "Permanently revoke a token",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scope": "admin",
        "x-stage3-behavior": "token-store-only-no-backend-request",
        "responses": {
          "204": {
            "description": "Token digest and metadata removed.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/ContentTypeOptionsNoSniff"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/LastAdministrator"
          },
          "503": {
            "$ref": "#/components/responses/TokenStoreUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque"
      }
    },
    "parameters": {
      "OutletId": {
        "name": "outletId",
        "in": "path",
        "required": true,
        "description": "Project-owned opaque identifier resolved only through the current inventory.",
        "schema": {
          "$ref": "#/components/schemas/OutletId"
        }
      }
    },
    "schemas": {
      "OutletId": {
        "type": "string",
        "minLength": 22,
        "maxLength": 22,
        "pattern": "^[A-Za-z0-9_-]{22}$",
        "description": "Base64url prefix of SHA-256 over the versioned backend row identity; collisions fail closed."
      },
      "InventoryRevision": {
        "type": "string",
        "minLength": 22,
        "maxLength": 22,
        "pattern": "^[A-Za-z0-9_-]{22}$",
        "description": "Opaque digest of the complete validated inventory used to detect stale action mappings."
      },
      "OutletState": {
        "type": "string",
        "enum": [
          "on",
          "off",
          "unknown"
        ]
      },
      "OutletAction": {
        "type": "string",
        "enum": [
          "on",
          "off",
          "cycle"
        ]
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "status"
        ],
        "properties": {
          "apiVersion": {
            "type": "string",
            "const": "v1"
          },
          "status": {
            "type": "string",
            "const": "live"
          }
        }
      },
      "Outlet": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pduId",
          "position",
          "name",
          "state",
          "availableActions"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OutletId"
          },
          "pduId": {
            "$ref": "#/components/schemas/PduId"
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          },
          "name": {
            "type": "string",
            "minLength": 0,
            "maxLength": 128
          },
          "state": {
            "$ref": "#/components/schemas/OutletState"
          },
          "availableActions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OutletAction"
            },
            "maxItems": 3,
            "uniqueItems": true,
            "description": "Always empty in Stage 2. Later stages may expose only independently authorized actions."
          }
        }
      },
      "OutletCollection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "inventoryRevision",
          "outlets"
        ],
        "properties": {
          "apiVersion": {
            "type": "string",
            "const": "v1"
          },
          "inventoryRevision": {
            "$ref": "#/components/schemas/InventoryRevision"
          },
          "outlets": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "$ref": "#/components/schemas/Outlet"
            }
          }
        }
      },
      "OutletActionRequest": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 2,
        "maxProperties": 2,
        "required": [
          "action",
          "inventoryRevision"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "on",
              "off",
              "cycle"
            ]
          },
          "inventoryRevision": {
            "$ref": "#/components/schemas/InventoryRevision"
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "bad_request",
          "unauthorized",
          "forbidden",
          "not_found",
          "method_not_allowed",
          "not_acceptable",
          "unsupported_media_type",
          "payload_too_large",
          "inventory_stale",
          "backend_unavailable",
          "backend_protocol_error",
          "action_disabled",
          "action_outcome_unknown",
          "internal_error",
          "last_administrator",
          "token_limit_reached",
          "token_store_unavailable"
        ]
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "PduId": {
        "type": "string",
        "minLength": 22,
        "maxLength": 22,
        "pattern": "^[A-Za-z0-9_-]{22}$",
        "description": "Domain-separated opaque identifier derived from the validated backend PDU row identity; collisions fail closed."
      },
      "TokenRecordId": {
        "type": "string",
        "pattern": "^tok_[A-Za-z0-9_-]{22}$",
        "minLength": 26,
        "maxLength": 26,
        "description": "Opaque identifier for a token record; not a bearer credential."
      },
      "TokenScope": {
        "type": "string",
        "enum": [
          "read",
          "control",
          "admin"
        ]
      },
      "TokenCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 2,
        "maxProperties": 3,
        "required": [
          "label",
          "scope"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]{1,64}$",
            "x-max-utf8-bytes": 128
          },
          "scope": {
            "$ref": "#/components/schemas/TokenScope"
          },
          "outlets": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/OutletId"
            }
          }
        },
        "description": "Omit outlets for unrestricted outlet access. An empty array grants access to no outlets."
      },
      "TokenMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "createdAt",
          "enabled",
          "scope",
          "outlets"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/TokenRecordId"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]{1,64}$",
            "x-max-utf8-bytes": 128
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "enabled": {
            "type": "boolean"
          },
          "scope": {
            "$ref": "#/components/schemas/TokenScope"
          },
          "outlets": {
            "oneOf": [
              {
                "type": "array",
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/components/schemas/OutletId"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "null means unrestricted; an empty array denies all outlets."
          }
        }
      },
      "TokenCreated": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "createdAt",
          "enabled",
          "scope",
          "outlets",
          "token"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/TokenRecordId"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]{1,64}$",
            "x-max-utf8-bytes": 128
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "enabled": {
            "type": "boolean"
          },
          "scope": {
            "$ref": "#/components/schemas/TokenScope"
          },
          "outlets": {
            "oneOf": [
              {
                "type": "array",
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/components/schemas/OutletId"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "null means unrestricted; an empty array denies all outlets."
          },
          "token": {
            "type": "string",
            "pattern": "^pm3_[A-Za-z0-9_-]{43}$",
            "minLength": 47,
            "maxLength": 47,
            "description": "Returned exactly once. Never persisted in plaintext and never returned by list operations.",
            "readOnly": true
          }
        }
      },
      "TokenCollection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tokens"
        ],
        "properties": {
          "tokens": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "$ref": "#/components/schemas/TokenMetadata"
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The JSON body is malformed, duplicated, or violates the closed schema.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControlNoStore"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/ContentTypeOptionsNoSniff"
          }
        }
      },
      "PayloadTooLarge": {
        "description": "The raw request body exceeds 1,024 bytes.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControlNoStore"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/ContentTypeOptionsNoSniff"
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "The request is not unencoded UTF-8 application/json.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControlNoStore"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/ContentTypeOptionsNoSniff"
          }
        }
      },
      "InventoryStale": {
        "description": "The supplied inventory revision does not match the current validated identity mapping.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControlNoStore"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/ContentTypeOptionsNoSniff"
          }
        }
      },
      "OutletCollection": {
        "description": "Current validated outlet inventory.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/OutletCollection"
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControlNoStore"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/ContentTypeOptionsNoSniff"
          }
        }
      },
      "Outlet": {
        "description": "One outlet resolved from the current inventory.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Outlet"
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControlNoStore"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/ContentTypeOptionsNoSniff"
          }
        }
      },
